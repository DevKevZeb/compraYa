# Supabase project settings (Dashboard > Project Settings > API Keys).
# EXPO_PUBLIC_* values are bundled into the app, so only use public keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key

# Optional: shared demo account shown as "Entrar como invitado" on the welcome screen.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
